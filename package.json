{
  "name": "career-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.21.0 <25", "npm": ">=11 <12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:publish": "node scripts/check-publish.mjs",
    "probe:apis": "node scripts/probe-public-apis.mjs",
    "demo:automation": "node server/demo.ts",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "test:official-examples": "vitest run tests/saramin-official-examples.test.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm run build:apps-script && npm test && npm run check:publish",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
